#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

head="$(git rev-parse HEAD)"
branches=0
while read -r local_ref local_sha _ _; do
	[[ $local_sha =~ ^0+$ || $local_ref == refs/tags/* ]] && continue
	branches=$((branches + 1))
	if [[ $local_sha != "$head" ]]; then
		printf 'REF: %s is not the checked-out commit; check it out and push again\n' "$local_ref" >&2
		exit 1
	fi
done
[[ $branches -gt 0 ]] || exit 0

if [[ -n "$(git status --porcelain)" ]]; then
	printf 'DIRTY: commit or stash the working tree; the checks read it, not the pushed commits\n' >&2
	exit 1
fi

ci_python="$(sed -nE "s/^ *python-version: '([0-9.]+)'$/\1/p" .github/workflows/ci.yml)"
py=(uv run -q --no-project --python "$ci_python" python)
"${py[@]}" tools/test_check_rows.py
"${py[@]}" tools/check_rows.py --base origin/main
"${py[@]}" tools/census/test_census.py
bash tools/rails_ceiling.sh
git ls-files -z '*.md' | grep -zv tests/fixtures/ | xargs -0 plugins/whetstone/bin/claim-check
node_modules/.bin/oxfmt --check
node_modules/.bin/oxlint --deny-warnings
node_modules/.bin/tsc -p .
node_modules/.bin/vitest run --reporter=dot
claude plugin test plugins/dossier | grep -v "^(pass)"
claude plugin test plugins/whetstone | grep -v "^(pass)"
