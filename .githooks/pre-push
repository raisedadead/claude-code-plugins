#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# A linked worktree exports GIT_DIR, so a check's git command in another repo would act on this one.
# Clear them before the DIRTY check, so it reads the same index and config as the checks.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

head="$(git rev-parse HEAD)"
branches=0
while read -r local_ref local_sha _ _; do
	[[ $local_sha =~ ^0+$ || $local_ref == refs/tags/* ]] && continue
	branches=$((branches + 1))
	if [[ $local_sha != "$head" ]]; then
		printf 'REF: %s is not the checked-out commit; check it out and push again\n' "$local_ref" >&2
		exit 1
	fi
done
[[ $branches -gt 0 ]] || exit 0

if [[ -n "$(git status --porcelain)" ]]; then
	printf 'DIRTY: commit or stash the working tree; the checks read it, not the pushed commits\n' >&2
	exit 1
fi

unset CI_STEPS CI_LIST
if [[ -n ${PRE_PUSH_STEPS:-} ]]; then
	printf 'pre-push: PRE_PUSH_STEPS runs only: %s\n' "$PRE_PUSH_STEPS" >&2
	export CI_STEPS="$PRE_PUSH_STEPS"
fi
exec bash tools/ci.sh all
